{
  "name": "disposable-check-mcp",
  "version": "1.0.0",
  "description": "MCP server for the DisposableCheck API — detect disposable email addresses",
  "type": "module",
  "bin": {
    "disposable-check-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "start": "node build/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "disposable-email",
    "email-validation",
    "claude",
    "modelcontextprotocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.87.0"
  },
  "engines": {
    "node": ">=18"
  }
}
