{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "disposable-check-mcp",
  "account_id": "ccbc9926d08a298aee2a4f0cffcfc4a3",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-30",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DISPOSABLE_CHECK_BASE_URL": "https://disposablecheck.irensaltali.com/api"
  },
  "services": [
    {
      "binding": "DISPOSABLE_CHECK_API",
      "service": "disposable-check-api"
    }
  ],
  "routes": [
    {
      "pattern": "disposablecheck.irensaltali.com/mcp",
      "zone_name": "irensaltali.com"
    },
    {
      "pattern": "disposablecheck.irensaltali.com/mcp/*",
      "zone_name": "irensaltali.com"
    }
  ]
}
